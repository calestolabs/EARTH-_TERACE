rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/investigations/{investigationId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'evidenceJson', 'schemaVersion', 'createdAt'])
          && d.keys().hasAll(['title', 'evidenceJson', 'schemaVersion', 'createdAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.evidenceJson is string && d.evidenceJson.size() <= 500000
          && d.schemaVersion == 1 && d.createdAt == request.time;
      }
      allow read, delete: if owner();
      allow create: if owner() && valid();
      // Supports an explicit retry of the same client-generated save ID.
      allow update: if owner() && valid();
    }
    // All other paths remain denied unless another explicit rule grants access.
  }
}
